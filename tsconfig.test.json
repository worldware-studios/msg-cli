{
  // Type-checks src/ including tests and fixtures. Tests run under Vitest as
  // ESM (they use import.meta.url), so this overrides the CommonJS module
  // settings of tsconfig.json, which stays as-is for the published build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
